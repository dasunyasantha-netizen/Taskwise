{
  "name": "taskwise-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "tsx src/tests/companyHelpers.test.ts && tsx src/tests/taskFilters.test.ts && tsx src/tests/deduction.test.ts && tsx src/tests/companyOnboarding.test.ts && tsx src/tests/fourLevelHierarchy.test.ts",
    "test:helpers": "tsx src/tests/companyHelpers.test.ts",
    "test:integration": "tsx src/tests/companyOnboarding.test.ts",
    "test:hierarchy": "tsx src/tests/fourLevelHierarchy.test.ts",
    "test:yso": "tsx --test src/tests/ysoRules.test.ts",
    "test:yso:integration": "tsx src/tests/ysoIntegration.test.ts",
    "test:letters": "npm run build && tsx src/tests/letters.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^5.8.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/web-push": "^3.6.4",
    "exceljs": "^4.4.0",
    "prisma": "^5.8.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
